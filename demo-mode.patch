diff --git a/src/lungisa/lib/demo.test.ts b/src/lungisa/lib/demo.test.ts
new file mode 100644
index 0000000..cec79ee
--- /dev/null
+++ b/src/lungisa/lib/demo.test.ts
@@ -0,0 +1,35 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { demoCandidate, initDemoMode, isDemoMode } from "./demo";
+
+const c = { id: "1", name: "Real Name", location: "Khayelitsha" };
+
+describe("demo mode", () => {
+  beforeEach(() => {
+    sessionStorage.clear();
+    window.history.pushState({}, "", "/");
+  });
+
+  it("leaves data alone when off", () => {
+    initDemoMode();
+    expect(isDemoMode()).toBe(false);
+    expect(demoCandidate(c)).toEqual(c);
+  });
+
+  it("masks name and location with ?demo=1 and persists", () => {
+    window.history.pushState({}, "", "/?demo=1");
+    initDemoMode();
+    window.history.pushState({}, "", "/browse");
+    const out = demoCandidate(c);
+    expect(out.name).toMatch(/^Candidate [A-Z]/);
+    expect(out.location).toBe("Cape Town");
+    expect(demoCandidate(c).name).toBe(out.name);
+    expect(isDemoMode()).toBe(true);
+  });
+
+  it("turns off with ?demo=0", () => {
+    sessionStorage.setItem("lungisa_demo", "1");
+    window.history.pushState({}, "", "/?demo=0");
+    initDemoMode();
+    expect(isDemoMode()).toBe(false);
+  });
+});
diff --git a/src/lungisa/lib/demo.ts b/src/lungisa/lib/demo.ts
new file mode 100644
index 0000000..84d35e1
--- /dev/null
+++ b/src/lungisa/lib/demo.ts
@@ -0,0 +1,62 @@
+// Demo mode hides candidate identity for screen shares with people who are not
+// named employers. It only changes what is displayed; no data is altered.
+// Turn on with ?demo=1 (stays on for the browser session), off with ?demo=0.
+
+const KEY = "lungisa_demo";
+
+function readStored(): boolean {
+  try {
+    return sessionStorage.getItem(KEY) === "1";
+  } catch {
+    return false;
+  }
+}
+
+export function initDemoMode(): void {
+  if (typeof window === "undefined") return;
+  try {
+    const flag = new URLSearchParams(window.location.search).get("demo");
+    if (flag === "1") sessionStorage.setItem(KEY, "1");
+    if (flag === "0") sessionStorage.removeItem(KEY);
+  } catch {
+    // storage unavailable: demo mode simply stays off
+  }
+  document.documentElement.classList.toggle("demo-on", readStored());
+}
+
+export function isDemoMode(): boolean {
+  return typeof window !== "undefined" && readStored();
+}
+
+const letters = new Map<string, string>();
+
+function labelFor(id: string): string {
+  let label = letters.get(id);
+  if (!label) {
+    const n = letters.size;
+    label = `Candidate ${String.fromCharCode(65 + (n % 26))}${n >= 26 ? Math.floor(n / 26) : ""}`;
+    letters.set(id, label);
+  }
+  return label;
+}
+
+export const DEMO_LOCATION = "Cape Town";
+
+export function demoName<T extends string | null>(id: string, name: T): T {
+  return (isDemoMode() && name !== null ? labelFor(id) : name) as T;
+}
+
+export function demoLocation<T extends string | null>(location: T): T {
+  return (isDemoMode() && location !== null ? DEMO_LOCATION : location) as T;
+}
+
+export function demoCandidate<
+  T extends { id: string; name: string; location: string | null },
+>(candidate: T): T {
+  if (!isDemoMode()) return candidate;
+  return {
+    ...candidate,
+    name: labelFor(candidate.id),
+    location: candidate.location === null ? null : DEMO_LOCATION,
+  };
+}
